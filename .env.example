# Only for the optional admin scripts in scripts/ (set-admin.js, migrate-v22-to-v23.js):
# path to a service-account JSON downloaded from Firebase console > Project settings > Service accounts.
# Keep that file OUT of the project folder and out of git. Using it does not require the Blaze plan.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
